@page "/"
@using System.Linq
@using BYUNotes.Web.Components.Pages.Notes
@using BYUNotes.Web.Models
@using BYUNotes.Web.Services

@inject NoteService NoteService
@inject ExportNoteService ExportNoteService
@inject IJSRuntime JS

<PageTitle>BYUNotes Dashboard</PageTitle>

<h1>BYUNotes Dashboard</h1>
<p>Organize your studies in one place.</p>

<div class="row mt-4 g-3">

    <!-- LEFT PANEL: NOTES LIST -->
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <h3>My Notes</h3>
            <hr />

            <input class="form-control mb-3"
                   placeholder="Search notes..."
                   @bind="searchText"
                   @bind:event="oninput" />

            @if (notes.Count == 0)
            {
                <p class="text-muted">
                    No notes yet. Create your first note!
                </p>
            }
            else if (!filteredNotes.Any())
            {
                <p class="text-muted">
                    No matching notes found.
                </p>
            }
            else
            {
                @foreach (var note in filteredNotes)
                {
                    <button type="button"
                            @key="note.Id"
                            class="btn mb-2 text-start @(selectedNote?.Id == note.Id ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SelectNote(note)">

                        <strong>@note.Title</strong>
                        <br />
                        <small>
                            Edited: @note.LastEdited.ToString("MMM dd, yyyy h:mm tt")
                        </small>
                    </button>
                }
            }

            <hr />

            
                <label class="form-label">
                    Note Type
                </label>

                <select class="form-select mb-2"
                        @bind="newNoteType">
                    <option value="Text">Text Note</option>
                    <option value="Cornell">Cornell Notes</option>
                    <option value="Outline">Outline Notes</option>
                </select>


            <button type="button"
                    class="btn btn-success"
                    @onclick="CreateNoteAsync">
                + New Note
            </button>
        </div>
    </div>
    <!-- RIGHT PANEL: NOTE EDITOR -->
    <div class="col-md-8">
        <div class="card p-3 h-100">
            @if (selectedNote is not null)
            {
                
            if (selectedNote is CornellNote cornellNote)
            {
                <CornellNoteComponent SelectedNote="cornellNote"
                                    OnDelete="DeleteNoteAsync" />
            }
            else if (selectedNote is TextNote textNote)
            {
                <TextNoteComponent SelectedNote="textNote"
                                OnDelete="DeleteNoteAsync" />
            }
            else if (selectedNote is OutlineNote outlineNote)
            {
                <OutlineNoteComponent
                    @key="outlineNote.Id"
                    SelectedNote="outlineNote"
                    OnDelete="DeleteNoteAsync" />
            }

                 <!-- EXPORT BUTTONS -->
                <div class="d-flex gap-2 mb-3">
                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="() => ExportNoteAsync(false)">
                        Export .txt
                    </button>

                    <button type="button"
                            class="btn btn-outline-success"
                            @onclick="() => ExportNoteAsync(true)">
                        Export .md
                    </button>
                </div>
            }
            else
            {
                <h5>Select a note</h5>
                <p>
                    Choose a note from the left panel
                    or create a new one.
                </p>
            }
    </div>
</div>            
</div>


@code {

    private List<Note> notes = new();

    private Note? selectedNote;
    private string newNoteType = "Text";
    private string searchText = "";

    private IEnumerable<Note> filteredNotes =>
        notes.Where(note =>
            (note.Title ?? "").Contains(
                searchText ?? "",
                StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        notes= await NoteService.LoadNotesAsync();
        if (notes.Count > 0)
            selectedNote = notes[0];
    }

    private void SelectNote(Note note)
    {
        selectedNote = note;
        
    }

    
        private async Task CreateNoteAsync()
        {
            Note note = newNoteType switch
            {
                "Cornell" => new CornellNote(),
                "Outline" => new OutlineNote(),
                _ => new TextNote()
            };

            note.Title = "Untitled Note";

            await NoteService.CreateNoteAsync(note);

            notes.Insert(0, note);
            selectedNote = note;

            
        }

    private async Task DeleteNoteAsync()
    {
        if (selectedNote is null)
            return;

        await NoteService.DeleteNoteAsync(selectedNote);

        notes.Remove(selectedNote);

        selectedNote = notes.FirstOrDefault();
    }


    private async Task ExportNoteAsync(bool markdown)
    {
        await ExportNoteService.ExportNoteAsync(markdown, selectedNote);
    }


}

